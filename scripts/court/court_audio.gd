extends Node
## Court sound: a small pool of players for one-shots (bounce, swish, rim,
## squeak, catch, whistle, buzzer, cheer) and a looping crowd bed. Sounds
## with several takes pick one at random and vary pitch a little so
## repeated dribbles don't sound stamped. Files: assets/audio/court_*.ogg
## (generated by tools/court_assets/make_audio.py).

const SOUNDS: Dictionary = {
	"bounce": ["court_bounce_1", "court_bounce_2", "court_bounce_3"],
	"squeak": ["court_squeak_1", "court_squeak_2", "court_squeak_3"],
	"swish": ["court_swish"],
	"rim": ["court_rim"],
	"catch": ["court_catch"],
	"whistle": ["court_whistle"],
	"buzzer": ["court_buzzer"],
	"cheer": ["court_cheer"],
}
const POOL: int = 8
## Everything sits this far under its authored level.
const MASTER_DB: float = -12.0
const PREFS_PATH := "user://court_audio.cfg"
const PREFS_SECTION := "court"
const PREFS_KEY := "volume"
static var _saved_volume := -1.0

static func volume() -> float:
	if _saved_volume >= 0.0:
		return _saved_volume
	var cfg := ConfigFile.new()
	if cfg.load(PREFS_PATH) == OK:
		_saved_volume = clampf(float(cfg.get_value(PREFS_SECTION, PREFS_KEY, 1.0)), 0.0, 1.0)
	else:
		_saved_volume = 1.0
	return _saved_volume

static func set_volume(value: float) -> void:
	_saved_volume = clampf(value, 0.0, 1.0)
	var cfg := ConfigFile.new()
	cfg.load(PREFS_PATH)
	cfg.set_value(PREFS_SECTION, PREFS_KEY, _saved_volume)
	cfg.save(PREFS_PATH)
	AudioServer.set_bus_volume_linear(AudioServer.get_bus_index("Master"), _saved_volume)

var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next: int = 0
var _crowd: AudioStreamPlayer


func _ready() -> void:
	AudioServer.set_bus_volume_linear(AudioServer.get_bus_index("Master"), volume())
	for key: String in SOUNDS:
		var takes: Array[AudioStream] = []
		for file: String in SOUNDS[key]:
			var stream: AudioStream = load("res://assets/audio/%s.ogg" % file)
			if stream != null:
				takes.append(stream)
		_streams[key] = takes
	for i in POOL:
		var p: AudioStreamPlayer = AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	var bed: AudioStreamOggVorbis = load("res://assets/audio/court_crowd_loop.ogg")
	if bed != null:
		bed.loop = true
		_crowd = AudioStreamPlayer.new()
		_crowd.stream = bed
		_crowd.volume_db = -20.0 + MASTER_DB
		add_child(_crowd)
		_crowd.play()


func play(key: String, volume_db: float = 0.0, pitch_spread: float = 0.06) -> void:
	var takes: Array = _streams.get(key, [])
	if takes.is_empty():
		return
	var p: AudioStreamPlayer = _players[_next]
	_next = (_next + 1) % POOL
	p.stream = takes[randi() % takes.size()]
	p.volume_db = volume_db + MASTER_DB
	p.pitch_scale = 1.0 + randf_range(-pitch_spread, pitch_spread)
	p.play()


## The crowd gets louder in a close game late; 0 = calm, 1 = roaring.
func set_crowd_energy(energy: float) -> void:
	if _crowd != null:
		_crowd.volume_db = lerpf(-22.0, -12.0, clampf(energy, 0.0, 1.0)) + MASTER_DB
